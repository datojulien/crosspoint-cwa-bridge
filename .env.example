# LAN address of the host running the bridge. Do not include a port.
BRIDGE_BIND_ADDRESS=192.168.1.50
PUBLIC_BASE_URL=http://192.168.1.50:8094
ADMIN_PUBLIC_URL=https://192.168.1.50:8095

# Docker network and service origin used by Calibre-Web-Automated.
CWA_DOCKER_NETWORK=cwa_default
CWA_UPSTREAM_URL=http://cwa:8083

# Host UID/GID that owns ./cache, ./work, and ./state.
BRIDGE_UID=1000
BRIDGE_GID=1000

# Optional local image name or registry reference.
BRIDGE_IMAGE=crosspoint-cwa-bridge:local
